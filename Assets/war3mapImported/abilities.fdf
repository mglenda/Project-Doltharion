Frame "SIMPLEFRAME" "AbilityContainer" {
	Width 0.001,
	Height 0.001,
}

Frame "FRAME" "AbilityListenerContainer"{
	Width 0.001,
	Height 0.001,
}

Frame "SIMPLEFRAME" "AbilityButton_Border"{
	Width 0.03,
	Height 0.03,
	Texture "AbilityButton_Border_Texture" {
		File "war3mapImported\Ability_Button_BorderModern.dds",
	}
}

Texture "AbilityButton_Highlight_Texture" {
	File "war3mapImported\FocusLayer.dds",
	AlphaMode "ADD",
}

Frame "SIMPLEBUTTON" "AbilityButton_Icon"{
	Width 0.025,
	Height 0.025,
	UseHighlight "AbilityButton_Highlight_Texture",
	Texture "AbilityButton_Icon_Texture" {
		File "war3mapImported\BTNElementalMagnet.dds",
	}
	String "AbilityButton_Icon_Text" {
		Anchor TOP, 0, -0.003,
		Font "Prototype.ttf", 0.01,
		FontColor 1.0 1.0 1.0 1.0,
	}
}

